/* 全局样式：只放变量级的东西，页面各自的布局写在自己 wxss 里 */
page {
  background: #f6f7f9;
  color: #1c1f24;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

view,
text {
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 0 24rpx 20rpx;
}

.muted {
  color: #8b909a;
}

.small {
  font-size: 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #1f6feb;
  color: #ffffff;
}

.btn-primary.btn-disabled {
  background: #c8d3e6;
  color: #ffffff;
}

.btn-ghost {
  background: #eef2f8;
  color: #1f6feb;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.chip-ok {
  background: #e8f5ec;
  color: #1a7f37;
}

.chip-warn {
  background: #fff4e0;
  color: #a15c00;
}

.chip-danger {
  background: #fdecec;
  color: #c62828;
}

.chip-muted {
  background: #eef0f3;
  color: #6b7280;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.divider {
  height: 1rpx;
  background: #eef0f3;
  margin: 20rpx 0;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: #8b909a;
  font-size: 26rpx;
}
